{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "consult-the-diagrams",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "diagrams.justglow.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"secrets": {
		"required": ["OPENAI_KEY", "OPENAI_UNSLOP_SKILL_ID", "OPENAI_MODEL", "OPENAI_REASONING_EFFORT"]
	}
}
